rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tournaments root collection
    match /tournaments/{tournamentId} {
      allow read: if true; // Public can view tournament metadata (draws, results, standings)
      allow create: if request.auth != null; // Authenticated user can create tournament
      allow update, delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || resource.data.admins[request.auth.uid] == true);

      // Subcollections under a tournament
      match /{document=**} {
        allow read: if true; // Public can read public subcollections (draws, results, motions, standings)
        allow write: if request.auth != null; // Admins and judges (or with auth tokens) can write
      }
    }

    // Direct users collection for profile / tournaments list
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
